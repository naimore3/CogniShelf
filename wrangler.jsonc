{
  // Cloudflare Workers 静态资源部署配置（Workers Builds）。
  // 站点由 MkDocs 构建到 ./site，本文件只负责把 ./site 当作静态资源发布，
  // 不需要 Worker 脚本（无 main 字段）。
  //
  // name 必须与 Cloudflare 仪表盘里的「项目名称」一致，否则构建时
  // `npx wrangler deploy` 会部署到另一个 Worker。
  "name": "cognishelf",

  // 上调需谨慎：这个日期决定 Workers 运行时行为。
  "compatibility_date": "2026-10-01",

  "assets": {
    // MkDocs 的 site_dir（mkdocs.yml 未覆盖，默认就是 site）。
    "directory": "./site",
    // MkDocs 会生成 404.html；缺省 "none" 会返回裸 404 而不是站点自己的 404 页。
    "not_found_handling": "404-page"
  }
}
